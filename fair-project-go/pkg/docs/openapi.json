{
  "openapi": "3.0.0",
  "info": {
    "title": "Fair Project Assignment API",
    "description": "API for assigning projects to students based on their preferences in a fair way.",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Welcome message",
        "description": "Returns a welcome message for the API with version information",
        "responses": {
          "200": {
            "description": "Welcome message with version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Welcome to the Fair Project Assignment API"
                    },
                    "version": {
                      "type": "string",
                      "example": "0.0.1"
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/classes": {
      "get": {
        "summary": "List all class/terms",
        "description": "Returns a list of all class/terms",
        "responses": {
          "200": {
            "description": "List of class/terms",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new class/term",
        "description": "Creates a new class/term directory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name of the class/term",
                    "example": "Fall2023"
                  }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Class/term created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Class/term 'Fall2023' created successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict - class/term already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/classes/{className}/projects": {
      "parameters": [
        {
          "name": "className",
          "in": "path",
          "required": true,
          "description": "Name of the class/term",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Get projects for a class/term",
        "description": "Returns a list of projects for a specific class/term",
        "responses": {
          "200": {
            "description": "List of projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid class/term name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found - class/term or projects not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Upload projects for a class/term",
        "description": "Uploads a list of projects for a specific class/term",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": ["Project1", "Project2", "Project3"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Projects saved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Projects for 'Fall2023' saved successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid class/term name or request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found - class/term not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/classes/{className}/students": {
      "parameters": [
        {
          "name": "className",
          "in": "path",
          "required": true,
          "description": "Name of the class/term",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Get students for a class/term",
        "description": "Returns a list of students for a specific class/term",
        "responses": {
          "200": {
            "description": "List of students",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StudentInput"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid class/term name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found - class/term or students not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Upload students for a class/term",
        "description": "Uploads a list of students for a specific class/term",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/StudentInput"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Students saved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Students for 'Fall2023' saved successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid class/term name or request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found - class/term not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/classes/{className}/assign": {
      "parameters": [
        {
          "name": "className",
          "in": "path",
          "required": true,
          "description": "Name of the class/term",
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Run assignment algorithm",
        "description": "Runs the assignment algorithm for a specific class/term",
        "responses": {
          "200": {
            "description": "Assignment completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Assignment completed successfully"
                    },
                    "class": {
                      "type": "string",
                      "example": "Fall2023"
                    },
                    "assignmentId": {
                      "type": "string",
                      "example": "1625097600000000000"
                    },
                    "results": {
                      "$ref": "#/components/schemas/AssignmentOutput"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid class/term name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found - class/term, projects, or students not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable entity - no projects or students found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/classes/{className}/assignments": {
      "parameters": [
        {
          "name": "className",
          "in": "path",
          "required": true,
          "description": "Name of the class/term",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "List assignments for a class/term",
        "description": "Returns a list of assignment IDs for a specific class/term",
        "responses": {
          "200": {
            "description": "List of assignment IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid class/term name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found - class/term not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/classes/{className}/assignments/{assignmentId}": {
      "parameters": [
        {
          "name": "className",
          "in": "path",
          "required": true,
          "description": "Name of the class/term",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "assignmentId",
          "in": "path",
          "required": true,
          "description": "ID of the assignment",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Get assignment result",
        "description": "Returns the result of a specific assignment",
        "responses": {
          "200": {
            "description": "Assignment result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssignmentOutput"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid class/term name or assignment ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found - class/term or assignment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "summary": "API Version",
        "description": "Returns the current version of the API",
        "responses": {
          "200": {
            "description": "Version information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string",
                      "example": "0.0.1"
                    },
                    "major": {
                      "type": "integer",
                      "example": 0
                    },
                    "minor": {
                      "type": "integer",
                      "example": 0
                    },
                    "patch": {
                      "type": "integer",
                      "example": 1
                    },
                    "branch_hash": {
                      "type": "string",
                      "example": "a1b2c3d",
                      "description": "Git branch hash, included when built with Docker or using build flags"
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "summary": "API Documentation",
        "description": "Returns the OpenAPI documentation for the API",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Format of the documentation (json or html)",
            "schema": {
              "type": "string",
              "enum": ["json", "html"],
              "default": "html"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OpenAPI documentation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          }
        },
        "required": ["error"]
      },
      "StudentInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the student"
          },
          "preferences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of project preferences in order of preference"
          }
        },
        "required": ["name", "preferences"]
      },
      "Student": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string",
            "description": "Name of the student"
          },
          "Preferences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of project preferences in order of preference"
          },
          "Assigned": {
            "type": "boolean",
            "description": "Whether the student has been assigned a project"
          },
          "AssignedProject": {
            "type": "string",
            "description": "The project assigned to the student"
          },
          "BadPreferences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of preferences that could not be assigned"
          }
        },
        "required": ["Name", "Preferences", "Assigned", "AssignedProject", "BadPreferences"]
      },
      "AssignmentOutput": {
        "type": "object",
        "properties": {
          "selectedByProjects": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Map of project names to student names"
          },
          "selectedByStudent": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Map of student names to project names"
          },
          "students": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Student"
            },
            "description": "List of students with their assignment status"
          },
          "remainingProjects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of projects that were not assigned to any student"
          }
        },
        "required": ["selectedByProjects", "selectedByStudent", "students", "remainingProjects"]
      }
    }
  }
}
