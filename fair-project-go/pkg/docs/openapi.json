  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT token in the format: Bearer {token}"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          }
        },
        "required": ["error"]
      },
      "StudentInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the student"
          },
          "preferences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of project preferences in order of preference"
          }
        },
        "required": ["name", "preferences"]
      },
      "Student": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string",
            "description": "Name of the student"
          },
          "Preferences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of project preferences in order of preference"
          },
          "Assigned": {
            "type": "boolean",
            "description": "Whether the student has been assigned a project"
          },
          "AssignedProject": {
            "type": "string",
            "description": "The project assigned to the student"
          },
          "BadPreferences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of preferences that could not be assigned"
          }
        },
        "required": ["Name", "Preferences", "Assigned", "AssignedProject", "BadPreferences"]
      },
      "AssignmentOutput": {
        "type": "object",
        "properties": {
          "selectedByProjects": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Map of project names to student names"
          },
          "selectedByStudent": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Map of student names to project names"
          },
          "students": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Student"
            },
            "description": "List of students with their assignment status"
          },
          "remainingProjects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of projects that were not assigned to any student"
          }
        },
        "required": ["selectedByProjects", "selectedByStudent", "students", "remainingProjects"]
      },
      "Role": {
        "type": "string",
        "enum": [
          "superadmin",
          "admin",
          "teacher",
          "student"
        ],
        "description": "User role in the system"
      },
      "User": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Username of the user"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "description": "Roles assigned to the user"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the user is enabled"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the user was created"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the user was last updated"
          }
        },
        "required": [
          "username",
          "roles",
          "enabled",
          "createdAt",
          "updatedAt"
        ]
      },
      "UserCredentials": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Username of the user"
          },
          "password": {
            "type": "string",
            "description": "Password of the user",
            "format": "password"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "NewUserRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Username of the new user"
          },
          "password": {
            "type": "string",
            "description": "Password of the new user",
            "format": "password"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "description": "Roles to assign to the new user"
          }
        },
        "required": [
          "username",
          "password",
          "roles"
        ]
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "description": "New roles to assign to the user"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the user should be enabled"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT token for authentication"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the token expires"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "token",
          "expiresAt",
          "user"
        ]
      }
    }
  }
}
